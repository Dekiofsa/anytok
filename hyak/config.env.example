# AnyTok on Hyak Tillicum -- cluster settings.
#
#   cp hyak/config.env.example hyak/config.env     # hyak/config.env is git-ignored
#   edit ANYTOK_ROOT and ANYTOK_RUNS (both must be absolute paths)
#
# This file is ALSO the list of defaults: a key missing from hyak/config.env
# takes the value written here.  An environment variable with the same name
# overrides the file (in bash and in Python alike).  Set HYAK_CONFIG to use a
# file at another location.
#
# Format (parsed identically by hyak/slurm/lib.sh and hyak/common/config.py;
# anything else is rejected with the offending line number):
#   KEY=value          unquoted: only the characters A-Z a-z 0-9 _ . / : @ % + , = -
#   KEY="some value"   double quotes: no " \ $ or backtick inside
#   KEY='some value'   single quotes: no ' inside
#   blank lines, "# comment" lines, and " # comment" after a value are allowed.
#
# Per-stage overrides: HYAK_<FLAG>_<STAGE> for FLAG in
#   PARTITION QOS ACCOUNT GRES CPUS MEM TIME SEGMENT_MARGIN_MINUTES PLATFORM
# and STAGE in
#   CHECK_ENV PROBE CORPUS WHEEL POOL STAGE_INPUTS INIT TRAIN_UNIFORM TRAIN_RL
#   EVAL_PREPARE EVAL_UNIFORM EVAL_RL REPLAY_CHECK SMOKE_TRAIN SMOKE_RAWBPB TRAIN_RAWBPB
# A per-stage override applies when it is non-empty.  For PARTITION, QOS,
# ACCOUNT, GRES, CPUS and MEM the value "none" (or an empty global value)
# omits that sbatch flag entirely.  One submission can set a key without
# editing this file:  hyak/slurm/submit.sh <stage> --env KEY=VALUE.
# Examples (commented out):
#   HYAK_TIME_POOL=12:00:00
#   HYAK_ACCOUNT_POOL=mygroup
#   HYAK_GRES_POOL=gpu:1
#   HYAK_TIME_SMOKE_TRAIN=00:40:00               # a shorter rehearsal ...
#   HYAK_SEGMENT_MARGIN_MINUTES_SMOKE_TRAIN=5    # ... needs a smaller margin (limit >= margin + 20 min)
# Do not use the MIG partition (gpu-h200-mig) for the pool: a MIG unit has 1 CPU
# and 30 GB, the pool needs 2 workers x 4 threads, and 8 units cost more than a GPU.

# --- Storage (required; must be absolute paths) -----------------------------
# Persistent project storage: environments, code, corpus, inputs, evaluation.
ANYTOK_ROOT=/gpfs/projects/CHANGE_ME/anytok
# Large storage for the two training runs (about 0.5 TB each).  Scrubbed
# storage deletes files not accessed for 60 days: copy final checkpoints away (README section 9).
ANYTOK_RUNS=/gpfs/scrubbed/CHANGE_ME/anytok-runs

# --- Slurm resources (D7: Tillicum caps 8 CPUs and 195.3125 GB per GPU) -------
HYAK_PARTITION=gpu-h200
HYAK_QOS=normal
HYAK_QOS_DEBUG=debug
# Empty = no --account flag (optional on Tillicum).
HYAK_ACCOUNT=
HYAK_GRES=gpu:1
HYAK_CPUS=8
# Empty = no --mem flag: the job gets the cluster's per-GPU default (documented as
# 195.3125 GB).  No explicit memory reservation was requested for this experiment.
# Set HYAK_MEM (for example 160G) or HYAK_MEM_<STAGE> only to override it.
HYAK_MEM=
HYAK_TIME=24:00:00
HYAK_TIME_DEBUG=01:00:00

# Short stages ask for short limits (the run guide's estimates with 2-3x headroom), which
# also schedules them sooner.  Training and the pool stay at the 24 h above.
HYAK_TIME_INIT=01:00:00
HYAK_TIME_CORPUS=06:00:00
HYAK_TIME_WHEEL=00:30:00
HYAK_TIME_REPLAY_CHECK=02:00:00
HYAK_TIME_EVAL_PREPARE=01:00:00
# The pre-flight rehearsal of one run: 2 h and a 10-minute margin (a training job needs
# a limit of at least margin + 20 minutes).
HYAK_TIME_SMOKE_TRAIN=02:00:00
HYAK_SEGMENT_MARGIN_MINUTES_SMOKE_TRAIN=10

# --- The raw-BPB handoff run (README section 0: Qingyun's launcher on his input bundle) ---------
# Output directories of the run and of its smoke test.  Empty = $ANYTOK_RUNS/raw-bpb-20k and
# $ANYTOK_RUNS/raw-bpb-smoke.  Absolute, normalised, outside the checkout, never the same directory.
# Never change HYAK_RAWBPB_OUTPUT (or ANYTOK_ROOT) once the run has started: the trainer records the
# input paths and refuses a resume with different ones.
HYAK_RAWBPB_OUTPUT=
HYAK_RAWBPB_SMOKE_OUTPUT=
# smoke-rawbpb runs in the debug QoS with the debug time limit (1 h) by default, like check-env.
HYAK_SEGMENT_MARGIN_MINUTES_SMOKE_RAWBPB=10
# train-rawbpb: Slurm's --signal=B:TERM comes this many minutes before the 24 h limit; the launcher
# forwards it to the trainer, which finishes the update, evaluates and writes a full restart (measured
# on a Tillicum H200: a whole fresh start + resume with three full saves took 158 s; see README 0.6).
HYAK_SEGMENT_MARGIN_MINUTES_TRAIN_RAWBPB=20

# --- Software -----------------------------------------------------------------
# Lmod modules loaded before "conda activate" (space separated; empty = none).
HYAK_MODULES="conda"
# Leave empty: torch==2.15.0 comes from PyPI (CUDA 13.2), as in the Modal images.  The
# only other builds are https://download.pytorch.org/whl/cu132 (the same CUDA 13.2) and
# .../cu134 (CUDA 13.4, needs a newer driver); neither helps a node whose driver is too
# old (below 580) -- there is no CUDA 12 build of torch 2.15.0 (see the run guide, 4.2).
HYAK_TORCH_INDEX_URL=

# --- Experiment runtime ---------------------------------------------------------
# Minutes before the job's end at which a training segment is asked to stop
# (in-process timer; Slurm --signal=B:TERM is the backup, capped at a quarter
# of the time limit and at 65535 seconds).  Training jobs need a time limit of at
# least margin + 20 minutes and a margin of at least 1 (submit.sh refuses less).
HYAK_SEGMENT_MARGIN_MINUTES=45
# Vocabulary rows per chunk of the memory-saving hypernetwork forward (D2).
# At least 4096 (smaller values, and 0 for the unchunked pinned forward, are refused: the
# pinned forward cannot fit an H200 at the pool's large vocabularies, and more, smaller chunks
# sum the weight gradients of all chunks in bf16 without lowering the peak).  Default 16384.
# If the probe (01_probe.sbatch) says
# DOES NOT FIT and the hypernetwork backward set the peak, use the largest smaller value that
# fits, never below 4096.  Never change it after the uniform bootstrap segment has started a
# run: resume refuses a different value, except with the recorded override (--accept-chunk-change "<reason>").
HYAK_HN_CHUNK_ROWS=16384
# Tokenizer generation: parallel tokenizers per job (timing only: each tokenizer keeps
# RAYON_NUM_THREADS=4 whatever the number of workers, and the tokenizer files do not change)
# and Rayon threads each (4: the original pool used it; the production pool refuses other
# values).  Default 2 workers x 4 threads on the 8 CPUs of one GPU.
HYAK_POOL_WORKERS=2
HYAK_POOL_THREADS=4
# Corpus build: parallel bucket processes per job.
HYAK_CORPUS_WORKERS=6

# --- Dashboard ------------------------------------------------------------------
HYAK_PLATFORM="Hyak Tillicum · H200"

# --- Hugging Face ---------------------------------------------------------------
# Optional token (all sources are public).  Never printed or logged.
HF_TOKEN=
